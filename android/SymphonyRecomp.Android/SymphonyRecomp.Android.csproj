<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0162;CS0219;CS0649;CS0414</NoWarn>
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>

    <ApplicationId>com.blacklabelhq.symphonyrecomp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>

    <!-- The Thor is arm64. Building a single ABI keeps the APK and the AOT step
         to a fraction of what a fat build costs. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Code mods use runtime-loaded IL and generated detour trampolines. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Runtime-loaded mods need untrimmed reflection targets and Mono JIT. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <!-- .NET 10 untrimmed JIT: use managed JNI registration, not broken native marshal stubs. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EnableLLVM>false</EnableLLVM>
  </PropertyGroup>

  <!-- Upstream patch resources. The second-screen map reads game RAM/VRAM. -->
  <ItemGroup>
    <EmbeddedResource Include="../../assets/extension/*.png" />
    <EmbeddedResource Include="../../assets/extension/room_fills.json" />
    <EmbeddedResource Include="../../assets/languages.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
  </ItemGroup>

  <!-- Game glue from the SymphonyRecomp tree. Paths are relative to this project.
       The recompiler writes generated/ from the disc; see android/README.md. -->
  <ItemGroup>
    <Compile Include="../../generated/**/*.cs" />
    <Compile Include="../../wrapers/**/*.cs" />
    <Compile Include="../../events/**/*.cs" />
    <Compile Include="../../misc/RgbaImage.cs" />
    <!-- All patches, not just widescreen: the recompiler bakes calls to
         Recompiled.RandoPatch, QualityOfLife, MovementCheat and FunctionFixes
         straight into the generated code, so the patch logic is not optional. -->
    <Compile Include="../../patches/**/*.cs" />
  </ItemGroup>

  <!-- The ImGui menus and panels are, though. Every file here is UI; the patch
       logic beside them has no ImGui dependency and stays in. -->
  <ItemGroup>
    <Compile Remove="../../patches/cheats/CheatMenu.cs" />
    <Compile Remove="../../patches/cheats/InventoryCheatPanel.cs" />
    <Compile Remove="../../patches/cheats/MovementCheatPanel.cs" />
    <Compile Remove="../../patches/cheats/StatsCheatPanel.cs" />
    <Compile Remove="../../patches/qol/QualityOfLifeMenu.cs" />
    <Compile Remove="../../patches/qol/QualityOfLifePanel.cs" />
    <Compile Remove="../../patches/rando/RandoMenu.cs" />
    <Compile Remove="../../patches/rando/RandoPanel.cs" />
    <Compile Remove="../../patches/tracker/TrackerMenu.cs" />
    <Compile Remove="../../patches/tracker/TrackerOverlayPanel.cs" />
    <Compile Remove="../../patches/tracker/MapOverlayPanel.cs" />
    <Compile Remove="../../patches/widescreen/WidescreenSettingsSection.cs" />
    <Compile Remove="../../patches/translation/TranslationSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../mods/CastleGearPlus/*.cs;../mods/CastleGearPlus/mod.json">
      <LogicalName>BundledMods.CastleGearPlus.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../mods/SkipPrologue/*.cs;../mods/SkipPrologue/mod.json">
      <LogicalName>BundledMods.SkipPrologue.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
